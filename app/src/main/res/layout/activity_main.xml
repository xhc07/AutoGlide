<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/margin_medium"
        tools:context=".MainActivity">

    <!--权限设置卡片-->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/permissionCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginEnd="@dimen/margin_medium"
        android:layout_marginTop="@dimen/margin_medium"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_medium">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_required_permission"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_subtitle"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/bind_accessibility_service"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body" />
                <!--无障碍服务权限开关-->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/accessibility_service_permission_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/accessibility_service_permission_switch"
                    app:thumbTint="@color/switch_thumb_color"
                    app:trackTint="@color/switch_track_color" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/overlay_permission_title"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body" />
                <!--悬浮窗权限开关-->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/overlayPermissionSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/overlay_permission_switch"
                    app:thumbTint="@color/switch_thumb_color"
                    app:trackTint="@color/switch_track_color" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!--偏好设置卡片-->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/settingsCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_medium"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/permissionCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_medium">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_preference_settings"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_subtitle"
                android:textStyle="bold" />

            <!--单次手势持续时间标题-->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:text="@string/setting_gesture_duration"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_body" />

            <!--持续时间模式：固定/随机-->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/gestureDurationModeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                app:checkedButton="@id/btnGestureDurationFixed"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGestureDurationFixed"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="0dp"
                    android:text="@string/mode_fixed"
                    android:textColor="@color/toggle_btn_text"
                    app:backgroundTint="@color/toggle_btn_bg"
                    tools:ignore="VisualLintButtonSize" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGestureDurationRandom"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="0dp"
                    android:text="@string/mode_random"
                    android:textColor="@color/toggle_btn_text"
                    app:backgroundTint="@color/toggle_btn_bg"
                    tools:ignore="VisualLintButtonSize" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!--固定持续时间-->
            <LinearLayout
                android:id="@+id/gestureDurationFixedContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/fixed_duration_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body" />

                    <TextView
                        android:id="@+id/gestureDurationValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="2dp"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        tools:text="450 毫秒" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gesture_duration_label_short"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/gestureDurationSlider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:stepSize="1.0"
                        android:value="450.0"
                        android:valueFrom="1.0"
                        android:valueTo="5000.0"
                        app:labelBehavior="gone"
                        app:tickColor="@android:color/transparent"
                        app:tickVisible="false"
                        app:thumbColor="@color/primary"
                        app:trackColorActive="@color/primary"
                        app:trackColorInactive="@color/switch_track_unchecked"
                        app:trackHeight="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gesture_duration_label_long"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!--随机持续时间范围-->
            <LinearLayout
                android:id="@+id/gestureDurationRandomContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/random_duration_range_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body" />

                    <TextView
                        android:id="@+id/gestureDurationRangeValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="2dp"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        tools:text="200 - 800 毫秒" />
                </LinearLayout>

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/gestureDurationRangeSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1.0"
                    android:valueFrom="1.0"
                    android:valueTo="5000.0"
                    app:labelBehavior="gone"
                    app:tickColor="@android:color/transparent"
                    app:tickVisible="false"
                    app:thumbColor="@color/primary"
                    app:trackColorActive="@color/primary"
                    app:trackColorInactive="@color/switch_track_unchecked"
                    app:trackHeight="4dp" />
            </LinearLayout>

            <!--底板透明度标题及当前数值-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setting_floating_panel_transparency"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body" />

                <TextView
                    android:id="@+id/transparencyValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold"
                    tools:text="40%" />
            </LinearLayout>
            <!--悬浮窗底板透明度滑动条-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/transparency_label_solid"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/transparencySlider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="0.0"
                    android:valueTo="100.0"
                    android:value="40.0"
                    android:stepSize="1.0"
                    app:labelBehavior="gone"
                    app:tickVisible="false"
                    app:tickColor="@android:color/transparent"
                    app:trackHeight="4dp"
                    app:thumbColor="@color/primary"
                    app:trackColorActive="@color/primary"
                    app:trackColorInactive="@color/switch_track_unchecked" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/transparency_label_transparent"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!--滑动像素速度标题-->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:text="@string/setting_pixel_speed"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_body" />

            <!--像素速度模式：固定/随机-->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/pixelSpeedModeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                app:checkedButton="@id/btnPixelSpeedFixed"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPixelSpeedFixed"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="0dp"
                    android:text="@string/mode_fixed"
                    android:textColor="@color/toggle_btn_text"
                    app:backgroundTint="@color/toggle_btn_bg"
                    tools:ignore="VisualLintButtonSize" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPixelSpeedRandom"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="0dp"
                    android:text="@string/mode_random"
                    android:textColor="@color/toggle_btn_text"
                    app:backgroundTint="@color/toggle_btn_bg"
                    tools:ignore="VisualLintButtonSize" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!--统一调整开关-->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/speedUnifiedSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:checked="false"
                android:text="@string/unified_adjustment"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body"
                app:thumbTint="@color/switch_thumb_color"
                app:trackTint="@color/switch_track_color" />

            <!--统一像素速度-->
            <LinearLayout
                android:id="@+id/pixelSpeedUnifiedContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pixel_speed_unified"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body" />

                    <TextView
                        android:id="@+id/pixelSpeedUnifiedValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="2dp"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        tools:text="3000 px/s" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/pixelSpeedUnifiedSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="1.0"
                    android:valueTo="10000.0"
                    android:value="3000.0"
                    android:stepSize="1.0"
                    app:labelBehavior="gone"
                    app:tickVisible="false"
                    app:tickColor="@android:color/transparent"
                    app:trackHeight="4dp"
                    app:thumbColor="@color/primary"
                    app:trackColorActive="@color/primary"
                    app:trackColorInactive="@color/switch_track_unchecked" />
            </LinearLayout>

            <!--上下方向像素速度-->
            <LinearLayout
                android:id="@+id/pixelSpeedVerticalContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pixel_speed_vertical"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body" />

                    <TextView
                        android:id="@+id/pixelSpeedVerticalValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="2dp"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        tools:text="3000 px/s" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/pixelSpeedVerticalSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="1.0"
                    android:valueTo="10000.0"
                    android:value="3000.0"
                    android:stepSize="1.0"
                    app:labelBehavior="gone"
                    app:tickVisible="false"
                    app:tickColor="@android:color/transparent"
                    app:trackHeight="4dp"
                    app:thumbColor="@color/primary"
                    app:trackColorActive="@color/primary"
                    app:trackColorInactive="@color/switch_track_unchecked" />
            </LinearLayout>

            <!--左右方向像素速度-->
            <LinearLayout
                android:id="@+id/pixelSpeedHorizontalContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pixel_speed_horizontal"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body" />

                    <TextView
                        android:id="@+id/pixelSpeedHorizontalValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="2dp"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        tools:text="3000 px/s" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/pixelSpeedHorizontalSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="1.0"
                    android:valueTo="10000.0"
                    android:value="3000.0"
                    android:stepSize="1.0"
                    app:labelBehavior="gone"
                    app:tickVisible="false"
                    app:tickColor="@android:color/transparent"
                    app:trackHeight="4dp"
                    app:thumbColor="@color/primary"
                    app:trackColorActive="@color/primary"
                    app:trackColorInactive="@color/switch_track_unchecked" />
            </LinearLayout>

            <!--随机统一像素速度范围-->
            <LinearLayout
                android:id="@+id/pixelSpeedUnifiedRangeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pixel_speed_unified_range"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body" />

                    <TextView
                        android:id="@+id/pixelSpeedUnifiedRangeValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="2dp"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        tools:text="1600 - 4000 px/s" />
                </LinearLayout>

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/pixelSpeedUnifiedRangeSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1.0"
                    android:valueFrom="1.0"
                    android:valueTo="10000.0"
                    app:labelBehavior="gone"
                    app:tickColor="@android:color/transparent"
                    app:tickVisible="false"
                    app:thumbColor="@color/primary"
                    app:trackColorActive="@color/primary"
                    app:trackColorInactive="@color/switch_track_unchecked"
                    app:trackHeight="4dp" />
            </LinearLayout>

            <!--随机上下像素速度范围-->
            <LinearLayout
                android:id="@+id/pixelSpeedVerticalRangeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pixel_speed_vertical_range"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body" />

                    <TextView
                        android:id="@+id/pixelSpeedVerticalRangeValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="2dp"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        tools:text="1600 - 4000 px/s" />
                </LinearLayout>

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/pixelSpeedVerticalRangeSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1.0"
                    android:valueFrom="1.0"
                    android:valueTo="10000.0"
                    app:labelBehavior="gone"
                    app:tickColor="@android:color/transparent"
                    app:tickVisible="false"
                    app:thumbColor="@color/primary"
                    app:trackColorActive="@color/primary"
                    app:trackColorInactive="@color/switch_track_unchecked"
                    app:trackHeight="4dp" />
            </LinearLayout>

            <!--随机左右像素速度范围-->
            <LinearLayout
                android:id="@+id/pixelSpeedHorizontalRangeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pixel_speed_horizontal_range"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body" />

                    <TextView
                        android:id="@+id/pixelSpeedHorizontalRangeValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="2dp"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        tools:text="1000 - 2500 px/s" />
                </LinearLayout>

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/pixelSpeedHorizontalRangeSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1.0"
                    android:valueFrom="1.0"
                    android:valueTo="10000.0"
                    app:labelBehavior="gone"
                    app:tickColor="@android:color/transparent"
                    app:tickVisible="false"
                    app:thumbColor="@color/primary"
                    app:trackColorActive="@color/primary"
                    app:trackColorInactive="@color/switch_track_unchecked"
                    app:trackHeight="4dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/pauseModeToggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@id/btnNoPause">
                <!--不停顿-->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNoPause"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="0dp"
                    android:text="@string/pause_mode_none"
                    app:backgroundTint="@color/toggle_btn_bg"
                    android:textColor="@color/toggle_btn_text"
                    tools:ignore="VisualLintButtonSize" />
                <!--固定时间-->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFixedPause"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="0dp"
                    android:text="@string/pause_mode_fixed"
                    app:backgroundTint="@color/toggle_btn_bg"
                    android:textColor="@color/toggle_btn_text"
                    tools:ignore="VisualLintButtonSize" />
                <!--随机时间-->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRandomPause"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="0dp"
                    android:text="@string/pause_mode_random"
                    app:backgroundTint="@color/toggle_btn_bg"
                    android:textColor="@color/toggle_btn_text"
                    tools:ignore="VisualLintButtonSize" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!--统一的停顿时间配置区域-->
            <LinearLayout
                android:id="@+id/pauseTimeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/pauseTimeLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body"
                        tools:text="@string/pause_time" />

                    <TextView
                        android:id="@+id/pauseTimeValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        tools:text="1" />
                </LinearLayout>

                <!--滑动选择区域-->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small">

                    <!-- 固定时间单向滑动条 -->
                    <com.google.android.material.slider.Slider
                        android:id="@+id/pauseTimeSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="1.0"
                        android:valueFrom="1.0"
                        android:valueTo="10.0"
                        android:value="1.0"
                        app:labelBehavior="gone"
                        app:tickVisible="false"
                        app:tickColor="@android:color/transparent"
                        app:trackHeight="4dp"
                        app:thumbColor="@color/primary"
                        app:trackColorActive="@color/primary"
                        app:trackColorInactive="@color/switch_track_unchecked"
                        android:visibility="gone" />

                    <!-- 随机时间范围滑动条 -->
                    <com.google.android.material.slider.RangeSlider
                        android:id="@+id/randomPauseTimeSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="1.0"
                        android:valueFrom="1.0"
                        android:valueTo="10.0"
                        app:labelBehavior="gone"
                        app:tickVisible="false"
                        app:tickColor="@android:color/transparent"
                        app:trackHeight="4dp"
                        app:thumbColor="@color/primary"
                        app:trackColorActive="@color/primary"
                        app:trackColorInactive="@color/switch_track_unchecked"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!--开始按钮-->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/startButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginEnd="@dimen/margin_medium"
        android:layout_marginTop="@dimen/margin_medium"
        android:text="@string/start"
        android:textColor="@color/on_primary"
        android:textSize="18sp"
        app:backgroundTint="@color/primary"
        app:cornerRadius="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settingsCard"
        tools:ignore="VisualLintButtonSize" />

    <!--作者与许可证信息-->
    <TextView
        android:id="@+id/creditModifiedText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginTop="@dimen/margin_medium"
        android:layout_marginEnd="@dimen/margin_medium"
        android:autoLink="web"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="@string/credit_modified"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/startButton" />

    <TextView
        android:id="@+id/creditOriginalText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginTop="@dimen/margin_small"
        android:layout_marginEnd="@dimen/margin_medium"
        android:autoLink="web"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="@string/credit_original"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/creditModifiedText" />

    <TextView
        android:id="@+id/creditLicenseText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginTop="@dimen/margin_small"
        android:layout_marginEnd="@dimen/margin_medium"
        android:layout_marginBottom="@dimen/margin_medium"
        android:gravity="center"
        android:text="@string/credit_license"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/creditOriginalText" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>